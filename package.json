{
  "name": "yihui-personal-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "fonts": "node scripts/subset-font.mjs",
    "predev": "npm run fonts",
    "dev": "vite",
    "prebuild": "npm run fonts",
    "build": "vite build",
    "preview": "vite preview",
    "dev:api": "wrangler d1 migrations apply DB --local && wrangler dev",
    "lint": "eslint .",
    "typecheck": "tsc -p worker",
    "test": "vitest run",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "deploy:ghpages": "npm run fonts && vite build --base=/YihuiPersonalWeb/ && node scripts/spa-fallback.mjs && gh-pages -d dist"
  },
  "dependencies": {
    "hono": "^4.13.19",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gh-pages": "^6.3.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "sass-embedded": "^1.108.2",
    "subset-font": "^2.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.163.0"
  }
}
